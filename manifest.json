{
  "manifest_version": 3,
  "name": "抖音下载与口播字幕",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "下载当前视频、直接读取平台已有字幕并导出带时间戳的 SRT。不会自动下载语音模型。",
  "permissions": [
    "downloads", "sidePanel", "storage", "activeTab"
  ],
  "host_permissions": [
    "https://*.douyin.com/*", "https://*.douyinvod.com/*", "https://*.toutiaovod.com/*",
    "https://*.zjcdn.com/*", "https://*.bytevcloudcdn.com/*", "https://*.volccdn.com/*",
    "https://*.bytetos.com/*", "https://*.ibytedtos.com/*", "https://*.byteimg.com/*",
    "https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*"
  ],
  "action": { "default_title": "打开口播字幕" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://*.douyin.com https://*.douyinvod.com https://*.toutiaovod.com https://*.zjcdn.com https://*.bytevcloudcdn.com https://*.volccdn.com https://*.bytetos.com https://*.ibytedtos.com https://*.byteimg.com https://huggingface.co https://*.huggingface.co https://*.hf.co"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "subtitle-core.js",
        "capture-core.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "core.js",
        "subtitle-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
